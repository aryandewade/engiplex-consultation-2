# Server & Database Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/consultflow
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=super_secure_jwt_secret_key_consultflow_2026_dev_prod

# Razorpay Integration
# (Leave as demo values to use the built-in Interactive Test Payment Simulator, or supply real Razorpay test keys)
RAZORPAY_KEY_ID=rzp_test_consultflow_demo_key
RAZORPAY_KEY_SECRET=rzp_secret_demo_consultflow_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_consultflow_2026

# Email Configuration (Optional SMTP / Resend)
# If unconfigured, the system uses the internal rich dev logger to render sent emails
EMAIL_API_KEY=
EMAIL_FROM=notifications@consultflow.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
